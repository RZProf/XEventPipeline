<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\XEventPipeline.SetupUi\XEventPipeline.SetupUi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ClickHouse.Driver" Version="1.4.0" />
        <PackageReference Include="Confluent.Kafka" Version="2.15.1" />
        <PackageReference Include="Confluent.Kafka.Extensions.Diagnostics" Version="0.5.0" />
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.12" />
        <PackageReference Include="Microsoft.SqlServer.XEvent.XELite" Version="2024.2.5.1" />
        <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
        <PackageReference Include="OpenTelemetry.AutoInstrumentation.Runtime.Native" Version="1.17.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.19.0-rc.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.19.0" />
        <PackageReference Include="Polly.Core" Version="8.8.0" />
        <PackageReference Include="SpanJson" Version="4.2.1" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="XEventPipeline.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="wwwroot/**/*">
            <TargetPath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/10.0.12/_framework/**">
            <Link>wwwroot/_framework/%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Update="appsettings.yml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
